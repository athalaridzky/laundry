@model ServicePageViewModel
@{
    ViewData["Title"] = "Layanan & harga";
}
<header class="page-header"><div><p class="eyebrow">Khusus Owner</p><h1>Layanan & harga</h1><p>Perubahan harga hanya berlaku untuk transaksi baru.</p></div></header>
<div class="split-page">
    <section class="content-section">
        <div class="section-heading"><div><h2>Daftar layanan</h2><p>@Model.Services.Count layanan aktif dan nonaktif.</p></div></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>Layanan</th><th>Kategori</th><th class="text-end">Harga</th><th>Durasi</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
        @foreach (ServiceDto service in Model.Services)
        {
            <tr><td><strong>@service.Name</strong></td><td>@(service.Category == ServiceCategory.PerKilo ? "Kiloan" : "Satuan")</td><td class="money text-end">@UiFormat.Currency(service.UnitPrice)</td><td>@(service.DurationDays.HasValue ? service.DurationDays == 0 ? "Hari yang sama" : $"{service.DurationDays} hari" : "—")</td><td><span class="status @(service.IsActive ? "status-success" : "status-neutral")">@(service.IsActive ? "Aktif" : "Nonaktif")</span></td><td><details class="row-menu"><summary>Ubah</summary><form asp-action="Update" asp-route-id="@service.Id" method="post" class="popover-form"><label>Nama<input name="Name" value="@service.Name" required /></label><label>Kategori<select name="Category"><option value="PerKilo" selected="@(service.Category == ServiceCategory.PerKilo ? "selected" : null)">Kiloan</option><option value="PerItem" selected="@(service.Category == ServiceCategory.PerItem ? "selected" : null)">Satuan</option></select></label><label>Harga<input name="UnitPrice" value="@service.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" inputmode="decimal" required /></label><label>Durasi hari<input name="DurationDays" value="@service.DurationDays" type="number" min="0" /></label><label class="check-row"><input name="IsActive" type="checkbox" value="true" checked="@(service.IsActive ? "checked" : null)" /><span>Aktif</span></label><div><button class="btn btn-primary btn-sm" type="submit">Simpan</button><button class="btn btn-danger btn-sm" type="submit" formaction="/Services/@service.Id/Delete" data-confirm="Nonaktifkan dan hapus layanan ini?">Hapus</button></div></form></details></td></tr>
        }
        </tbody></table></div>
    </section>
    <aside class="form-surface sticky-side"><p class="eyebrow">Layanan baru</p><h2>Tambah layanan</h2><form asp-action="Create" method="post" class="stack-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label for="Name">Nama layanan</label><input id="Name" name="Name" value="@Model.Form.Name" required maxlength="100" /></div><div class="field"><label for="Category">Kategori</label><select id="Category" name="Category"><option value="PerKilo">Kiloan</option><option value="PerItem">Satuan</option></select></div><div class="field"><label for="UnitPrice">Harga</label><div class="input-prefix"><span>Rp</span><input id="UnitPrice" name="UnitPrice" value="@Model.Form.UnitPrice" inputmode="decimal" required /></div></div><div class="field"><label for="DurationDays">Durasi (hari)</label><input id="DurationDays" name="DurationDays" value="@Model.Form.DurationDays" type="number" min="0" placeholder="Kosong untuk satuan" /><small>Gunakan 0 untuk selesai hari yang sama.</small></div><label class="check-row"><input name="IsActive" type="checkbox" value="true" checked /><span>Aktifkan layanan</span></label><button class="btn btn-primary" type="submit">Tambah layanan</button></form></aside>
</div>
