@model SettingsPageViewModel
@{
    ViewData["Title"] = "Pengaturan";
}
<header class="page-header"><div><p class="eyebrow">Khusus Owner</p><h1>Pengaturan</h1><p>Identitas usaha, struk, batas berat, dan akun staf.</p></div></header>
<div class="settings-grid">
    <section class="form-surface"><div class="section-heading"><div><h2>Usaha & struk</h2><p>Informasi ini tercetak pada setiap nota.</p></div></div><form asp-action="UpdateBusiness" method="post" class="stack-form"><div class="field"><label for="BusinessName">Nama usaha</label><input id="BusinessName" name="BusinessName" value="@Model.Business.BusinessName" required maxlength="150" /></div><div class="field"><label for="Address">Alamat</label><textarea id="Address" name="Address" required maxlength="300" rows="3">@Model.Business.Address</textarea></div><div class="field"><label for="PhoneNumber">Nomor telepon</label><input id="PhoneNumber" name="PhoneNumber" value="@Model.Business.PhoneNumber" maxlength="20" /></div><div class="field"><label for="ReceiptFooter">Footer struk</label><textarea id="ReceiptFooter" name="ReceiptFooter" maxlength="500" rows="3">@Model.Business.ReceiptFooter</textarea></div><div class="two-fields"><div class="field"><label for="PaperWidthMm">Lebar kertas</label><select id="PaperWidthMm" name="PaperWidthMm"><option value="80" selected="@(Model.Business.PaperWidthMm == 80 ? "selected" : null)">80 mm</option><option value="58" selected="@(Model.Business.PaperWidthMm == 58 ? "selected" : null)">58 mm</option></select></div><div class="field"><label for="OrderNumberPrefix">Prefix nota</label><input id="OrderNumberPrefix" name="OrderNumberPrefix" value="@Model.Business.OrderNumberPrefix" maxlength="10" required /></div></div><div class="field"><label for="MaxWeightKg">Berat maksimum per item</label><div class="input-suffix"><input id="MaxWeightKg" name="MaxWeightKg" value="@Model.Business.MaxWeightKg" inputmode="decimal" required /><span>kg</span></div></div><button class="btn btn-primary" type="submit">Simpan pengaturan</button></form></section>
    <div class="settings-users">
        <section class="content-section"><div class="section-heading"><div><h2>Akun pengguna</h2><p>Owner memiliki akses penuh; Kasir hanya operasional.</p></div></div><div class="user-list">@foreach (UserAccountDto user in Model.Users) { <article><div><strong>@user.FullName</strong><span>@@@user.UserName · @user.Role</span></div><form asp-action="SetUserActive" asp-route-id="@user.Id" method="post"><input type="hidden" name="isActive" value="@(!user.IsActive ? "true" : "false")" /><button class="btn btn-sm @(user.IsActive ? "btn-quiet" : "btn-secondary")" type="submit">@(user.IsActive ? "Nonaktifkan" : "Aktifkan")</button></form></article> }</div></section>
        <section class="form-surface"><div class="section-heading"><div><h2>Tambah akun</h2><p>Password wajib diganti saat login pertama.</p></div></div><form asp-action="CreateUser" method="post" class="stack-form"><div class="two-fields"><div class="field"><label for="FullName">Nama lengkap</label><input id="FullName" name="FullName" required maxlength="150" /></div><div class="field"><label for="UserName">Username</label><input id="UserName" name="UserName" required maxlength="50" autocomplete="off" /></div></div><div class="two-fields"><div class="field"><label for="Role">Peran</label><select id="Role" name="Role"><option value="Cashier">Kasir</option><option value="Owner">Owner</option></select></div><div class="field"><label for="Password">Password awal</label><input id="Password" name="Password" type="password" required minlength="8" autocomplete="new-password" /></div></div><button class="btn btn-primary" type="submit">Buat akun</button></form></section>
    </div>
</div>
