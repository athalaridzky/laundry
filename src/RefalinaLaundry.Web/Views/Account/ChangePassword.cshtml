@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Ubah password";
}
<div class="narrow-page">
    <header class="page-header"><div><p class="eyebrow">Keamanan akun</p><h1>Ubah password</h1><p>Password awal wajib diganti sebelum menggunakan aplikasi.</p></div></header>
    <section class="form-surface">
        <form method="post" class="stack-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="field"><label asp-for="CurrentPassword">Password lama</label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
            <div class="field"><label asp-for="NewPassword">Password baru</label><input asp-for="NewPassword" autocomplete="new-password" /><small>Gunakan minimal 8 karakter yang mudah Anda ingat dan tidak digunakan di tempat lain.</small><span asp-validation-for="NewPassword"></span></div>
            <div class="field"><label asp-for="ConfirmPassword">Ulangi password baru</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
            <button class="btn btn-primary" type="submit">Simpan password</button>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
